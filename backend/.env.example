DATABASE_URL=sqlite:///./faceattend.db
# Required for admin endpoints. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me
# Required: 32-byte key (base64) that encrypts face templates at rest. Losing it makes enrolments unreadable.
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
TEMPLATE_KEY=
MODELS_DIR=./models

# Recognition (SFace cosine similarity; OpenCV suggests ~0.36 for same person)
MATCH_THRESHOLD=0.42
MATCH_MARGIN=0.06
# Straight and turned frames must look like the same person
CONTINUITY_THRESHOLD=0.30
# Head-turn liveness: nose offset relative to eye distance
STRAIGHT_MAX_YAW=0.12
TURN_MIN_YAW=0.20
CHALLENGE_TTL_SECONDS=60

DEBOUNCE_SECONDS=120
MAX_IMAGE_MB=5
CORS_ORIGINS=http://localhost:5173
